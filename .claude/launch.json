{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", ". ./scripts/env.ps1; $env:AUTH_RATE_LIMIT_PER_MIN='300'; $env:RATE_LIMIT_PER_MIN='2000'; pnpm --filter '@wtl/api' start:prod"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", ". ./scripts/env.ps1; pnpm --filter '@wtl/web' start"],
      "port": 3000
    }
  ]
}
