TEST_DATABASE_URL=postgres://postgres:change-me@127.0.0.1:54329/webtrilieu_test
API_PORT=4000
# Mac dinh API chi nghe 127.0.0.1. Khi len nen tang (Render...) dat API_HOST=0.0.0.0 va KHONG dat API_PORT (nen tang cap PORT).
# API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
SEED_PASSWORD=change-me-Aa1!
HOTLINES=115:Cấp cứu y tế,111:Tổng đài bảo vệ trẻ em


# Web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# De trong: socket di qua cung origin (rewrite /socket.io). Dat khi API o domain rieng.
NEXT_PUBLIC_REALTIME_URL=

# So lop proxy tin cay truoc API de lay IP that (rate limit/nhat ky). Mac dinh: production=2 (reverse proxy + Next), con lai=0.
# Phai khop dung thuc te trien khai; sai thi hoac moi nguoi dung chung 1 IP, hoac khach gia duoc X-Forwarded-For.
# TRUST_PROXY_HOPS=2

# Gioi han dang nhap/dang ky moi phut moi IP (mac dinh 20). Chi nang len khi chay e2e tren may dev: AUTH_RATE_LIMIT_PER_MIN=300
# AUTH_RATE_LIMIT_PER_MIN=20
# Gioi han chung moi phut moi IP (mac dinh 120); e2e tren may dev dung RATE_LIMIT_PER_MIN=2000
# RATE_LIMIT_PER_MIN=120
# --- Email (quen mat khau) ---
# Khong dat SMTP_URL: dev/test ghi thu ra data/outbox/*.json; production se KHONG gui thu.
# Nha cung cap chon san: Brevo (goi mien phi ~300 thu/ngay, khong can ten mien rieng de bat dau).
# Cac buoc: dang ky brevo.com -> SMTP & API -> tao "SMTP key" -> Senders: xac minh dia chi gui (MAIL_FROM phai la dia chi da xac minh).
# SMTP_URL co dang smtp://<dang-nhap-smtp>:<smtp-key>@smtp-relay.brevo.com:587 (ky tu dac biet trong mat khau phai ma hoa %XX, dac biet dau @ trong dang nhap SMTP -> %40). KHONG commit gia tri that.
# Loi "525 5.7.1 Unauthorized IP address": Brevo dang chan IP may ban -> Security > Authorized IPs, tat chan hoac them IP hien tai.
# MAIL_FROM phai co dang  Ten <email@da-xac-minh>  (co dau < >).
# SMTP_URL=
# MAIL_FROM="Tri Lieu <dia-chi-da-xac-minh@example.com>"
# Thu muc luu anh tai len (mac dinh <goc repo>/data/uploads)
# UPLOAD_DIR=
