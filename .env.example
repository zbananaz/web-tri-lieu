# Web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# De trong: socket di qua cung origin (rewrite /socket.io). Dat khi API o domain rieng.
NEXT_PUBLIC_REALTIME_URL=

# So lop proxy tin cay truoc API de lay IP that (rate limit/nhat ky). Mac dinh: production=2 (reverse proxy + Next), con lai=0.
# Phai khop dung thuc te trien khai; sai thi hoac moi nguoi dung chung 1 IP, hoac khach gia duoc X-Forwarded-For.
# TRUST_PROXY_HOPS=2

# Gioi han dang nhap/dang ky moi phut moi IP (mac dinh 20). Chi nang len khi chay e2e tren may dev: AUTH_RATE_LIMIT_PER_MIN=300
# AUTH_RATE_LIMIT_PER_MIN=20
# Thu muc luu anh tai len (mac dinh <goc repo>/data/uploads)
# UPLOAD_DIR=
